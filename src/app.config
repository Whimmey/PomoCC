<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- 这里刻意不配置 System.Windows.Forms.ApplicationConfigurationSection。
       原因（实测）：
         1) 进程的 DPI 感知由 app.manifest 声明，与这里无关，文字照样清晰；
         2) 一旦启用 WinForms 的 DpiAwareness / HighDpiAutoResizing 开关，框架会在
            本程序自己的 Dpi.cs 缩放之后再缩放一次，500x400 的窗口变成 786x637，
            控件与字号对不上。缩放只由 Dpi.cs 负责，结果才可预测。
       app.config 保留为空文件只是为了让 dist 里的 exe.config 覆盖掉旧版本。 -->
</configuration>
