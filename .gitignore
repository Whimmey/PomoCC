# ============================================================
#  PomoCC / 番茄钟监督  ——  什么不该进仓库
# ============================================================

# ---------- 构建产物 ----------
# dist/ 完全由 build.ps1 生成（exe、exe.config、用户说明的副本）。
# 发布走 GitHub Releases，二进制不入库。
/dist/

# 兜底：任何地方都别提交二进制
*.exe
*.dll
*.pdb
*.obj
*.ilk
*.exp
*.lib
*.res
*.resources

# ---------- 编译器 / IDE ----------
bin/
obj/
.vs/
*.user
*.suo
*.userprefs
*.sln.docstates
*.VC.db

# ---------- 自检 / 测试的输出 ----------
# tests/ 里只有运行产物（日志、截图、假 SMTP 抓包）。
# 自检的源码在 src/SelfTest.cs，工具在 tools/，这两个是入库的。
/tests/*
!/tests/.gitkeep

# ---------- 运行时数据（隐私相关，务必不要提交）----------
# 真实数据在 %APPDATA%\PomodoroSupervisor\ 下。这里只是兜底：
# config.json 含 DPAPI 加密的邮箱授权码与密码散列，
# history.jsonl 含告状记录全文，都绝不能进仓库。
config.json
stats.json
history.jsonl
app.log

# ---------- 编辑器 / 系统垃圾 ----------
Thumbs.db
ehthumbs.db
desktop.ini
.DS_Store
*.swp
*.swo
*~
